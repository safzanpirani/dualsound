<Window x:Class="DualSound.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DualSound"
        Width="820"
        Height="720"
        MinWidth="720"
        MinHeight="660"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        AllowsTransparency="False"
        Background="{StaticResource Ink}"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
  <Border BorderBrush="#3A403B" BorderThickness="1" Background="{StaticResource Ink}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="46" />
        <RowDefinition Height="*" />
        <RowDefinition Height="42" />
      </Grid.RowDefinitions>

      <Border Grid.Row="0" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1"
              MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
        <Grid Margin="18,0,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Grid Width="20" Height="20" Margin="0,0,10,0">
              <Ellipse Stroke="{StaticResource Signal}" StrokeThickness="2" Width="15" Height="15" HorizontalAlignment="Left" />
              <Ellipse Fill="{StaticResource Signal}" Width="6" Height="6" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
            </Grid>
            <TextBlock Text="DUALSOUND" FontFamily="Bahnschrift SemiCondensed" FontWeight="Bold"
                       FontSize="13" VerticalAlignment="Center" />
            <TextBlock Text="  /  SYSTEM AUDIO MIRROR" Style="{StaticResource LabelText}" VerticalAlignment="Center" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal">
            <Button Style="{StaticResource IconButton}" Content="&#xE921;" ToolTip="Minimize" Click="Minimize_Click" />
            <Button Style="{StaticResource IconButton}" Content="&#xE8BB;" ToolTip="Close" Click="Close_Click" />
          </StackPanel>
        </Grid>
      </Border>

      <Grid Grid.Row="1" Margin="46,32,46,26">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="22" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="18" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="ONE STREAM. UP TO EIGHT OUTPUTS." FontFamily="Bahnschrift Condensed" FontWeight="Bold"
                       FontSize="28" />
            <TextBlock Text="Keep Windows on your main output and mirror everything to as many as seven more devices."
                       Foreground="{StaticResource Muted}" FontSize="13" Margin="0,5,0,0" />
          </StackPanel>
          <Button Grid.Column="1" Width="94" Height="34" VerticalAlignment="Center" Background="Transparent"
                  BorderBrush="{StaticResource Line}" BorderThickness="1" Foreground="{StaticResource Muted}"
                  FontFamily="Bahnschrift SemiCondensed" FontWeight="SemiBold" FontSize="11"
                  Cursor="Hand" Content="↻  REFRESH" Click="Refresh_Click" x:Name="RefreshButton" />
        </Grid>

        <Grid Grid.Row="2">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="48" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <Border Grid.Column="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                  CornerRadius="3" Padding="21,18">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="14" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="DEVICE 01" Style="{StaticResource LabelText}" />
                <Border Grid.Column="1" Background="#30362F" CornerRadius="2" Padding="7,3">
                  <TextBlock Text="WINDOWS DEFAULT" Foreground="{StaticResource Signal}" FontFamily="Bahnschrift SemiCondensed"
                             FontSize="9" FontWeight="Bold" />
                </Border>
              </Grid>
              <TextBlock Grid.Row="2" x:Name="PrimaryDeviceName" Text="Finding your default output…"
                         FontFamily="Bahnschrift SemiCondensed" FontSize="18" FontWeight="SemiBold"
                         TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
              <TextBlock Grid.Row="4" Text="Audio already plays here through Windows" Foreground="{StaticResource Muted}" FontSize="11" />
            </Grid>
          </Border>

          <Grid Grid.Column="1" VerticalAlignment="Center">
            <Line X1="0" X2="48" Y1="13" Y2="13" Stroke="{StaticResource Line}" StrokeThickness="1" />
            <Border Width="26" Height="26" CornerRadius="13" Background="{StaticResource Ink}" BorderBrush="{StaticResource Line}" BorderThickness="1">
              <TextBlock Text="+" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Signal}"
                         FontFamily="Bahnschrift" FontWeight="Bold" FontSize="15" />
            </Border>
          </Grid>

          <Border Grid.Column="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                  CornerRadius="3" Padding="21,18">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="10" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="9" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="ADDITIONAL OUTPUTS" Style="{StaticResource LabelText}" />
                <TextBlock Grid.Column="1" x:Name="SelectionCountText" Text="0 / 7 SELECTED"
                           Foreground="{StaticResource Signal}" FontFamily="Bahnschrift SemiCondensed" FontSize="10" FontWeight="Bold" />
              </Grid>
              <Border Grid.Row="2" Height="196" Background="#191C1A" BorderBrush="{StaticResource Line}" BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                  <ItemsControl x:Name="TargetDeviceRack">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Content="{Binding Name}"
                                  Checked="TargetDevice_Checked" Unchecked="TargetDevice_Unchecked"
                                  Foreground="{StaticResource Paper}" Cursor="Hand" FocusVisualStyle="{x:Null}">
                          <CheckBox.Template>
                            <ControlTemplate TargetType="CheckBox">
                              <Border x:Name="ItemChrome" Background="Transparent" BorderBrush="{StaticResource Line}"
                                      BorderThickness="0,0,0,1" Padding="12,9">
                                <Grid>
                                  <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                  </Grid.ColumnDefinitions>
                                  <TextBlock x:Name="SpeakerIcon" Text="&#xE7F5;" FontFamily="Segoe MDL2 Assets"
                                             Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" />
                                  <ContentPresenter Grid.Column="1" TextElement.FontSize="12" TextElement.Foreground="{TemplateBinding Foreground}"
                                                    VerticalAlignment="Center" RecognizesAccessKey="False" />
                                  <TextBlock x:Name="CheckMark" Grid.Column="2" Text="✓" Opacity="0" FontWeight="Bold"
                                             Foreground="{StaticResource Signal}" VerticalAlignment="Center" />
                                </Grid>
                              </Border>
                              <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                  <Setter TargetName="ItemChrome" Property="Background" Value="#252A26" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                  <Setter TargetName="ItemChrome" Property="BorderBrush" Value="{StaticResource Signal}" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                  <Setter TargetName="ItemChrome" Property="Background" Value="#30372F" />
                                  <Setter Property="Foreground" Value="{StaticResource Signal}" />
                                  <Setter TargetName="CheckMark" Property="Opacity" Value="1" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                  <Setter TargetName="ItemChrome" Property="Opacity" Value="0.58" />
                                </Trigger>
                              </ControlTemplate.Triggers>
                            </ControlTemplate>
                          </CheckBox.Template>
                        </CheckBox>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </Border>
              <TextBlock Grid.Row="4" Text="Click each output to toggle it — choose up to seven" Foreground="{StaticResource Muted}" FontSize="11" />
            </Grid>
          </Border>
        </Grid>

        <Border Grid.Row="4" Background="#1A1D1B" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="3" Padding="14,11">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="i" Width="20" Height="20" TextAlignment="Center" FontFamily="Georgia" FontWeight="Bold"
                       Foreground="{StaticResource Signal}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" x:Name="NoticeText"
                       Text="Bluetooth devices can add their own delay. Speakers and wired headphones work best together."
                       Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap" />
          </Grid>
        </Border>

        <Grid Grid.Row="6">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="18" />
            <ColumnDefinition Width="210" />
          </Grid.ColumnDefinitions>
          <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="3" Padding="17,0">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="#646B64" VerticalAlignment="Center" />
              <StackPanel Grid.Column="2" VerticalAlignment="Center">
                <TextBlock x:Name="StatusTitle" Text="READY" FontFamily="Bahnschrift SemiCondensed" FontSize="12" FontWeight="Bold" />
                <TextBlock x:Name="StatusDetail" Text="Choose at least one additional output" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,2,0,0" />
              </StackPanel>
              <TextBlock Grid.Column="3" x:Name="UptimeText" Text="00:00:00" Foreground="#5F665F"
                         FontFamily="Cascadia Mono, Consolas" FontSize="11" VerticalAlignment="Center" />
            </Grid>
          </Border>
          <Button Grid.Column="2" x:Name="ToggleButton" Style="{StaticResource PrimaryButton}"
                  Content="START MIRRORING" Click="ToggleButton_Click" IsEnabled="False" />
        </Grid>
      </Grid>

      <Border Grid.Row="2" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
        <Grid Margin="18,0">
          <TextBlock Text="UP TO 8 OUTPUTS  /  DRIVER-FREE  /  WASAPI SHARED MODE  /  NO ADMIN REQUIRED"
                     Style="{StaticResource LabelText}" FontSize="9" VerticalAlignment="Center" />
          <TextBlock Text="v1.0" Style="{StaticResource LabelText}" FontSize="9" HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
